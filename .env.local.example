# Bunny Storage Zone password.
# Bunny dashboard → Storage Zones → <your zone> → FTP & API Access → Password
BUNNY_STORAGE_PASSWORD=

# Bunny Account API key. Only required when purgeAfterUpload is true (the default).
# Bunny dashboard → Account → API → API Key
BUNNY_ACCOUNT_API_KEY=

# For another Angular configuration, use a distinct variable name configured
# with storagePasswordVar (and accountApiKeyVar when needed):
# BUNNY_STORAGE_PASSWORD_STAGING=
# BUNNY_ACCOUNT_API_KEY_STAGING=

# For SOPS/age deployments, configure secretsFile in angular.json instead.
# Keep plaintext credentials and age private keys outside the repository.
